# Neon: pooled connection for the application; direct connection for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set a different database branch and passwords for deploy previews.
APP_ENV=development
# One-time setup, consumed by npm run db:passwords; never exposed to the browser.
CAC_ADMIN_PASSWORD=
# Explicitly required by seed to prevent loading fictional students into production.
ALLOW_DEMO_SEED=false

# For Netlify deploy-preview and branch-deploy, set these in the corresponding context.
# CAC_PREVIEW_DATABASE_HOST must exactly match the hostname in the preview DATABASE_URL.
CAC_PREVIEW_DATABASE_HOST=
# Optional, used only by db:seed on a development/preview branch.
CAC_DEMO_BOOK_PASSWORD=

# Optional PostgreSQL utility directory for backup/recovery checks (otherwise PATH).
PG_BIN=
# Only an EMPTY temporary cac_restore_check_* database on the development server.
CAC_RESTORE_DATABASE_URL=
